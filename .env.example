# Application Environment
ENVIRONMENT=development
PROJECT_NAME="Document Intelligence & Question Extraction Service"
API_V1_STR=/api/v1
PYTHONPATH=backend

# Security & Tokens
SECRET_KEY=generate_a_strong_secret_key_here_at_least_32_chars_long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=document_intelligence
# Async URL for SQLAlchemy (asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/document_intelligence
# Sync URL for Alembic migrations
SYNC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/document_intelligence

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Storage Configuration
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=25

# AI & OCR Services
# Optional: Provide Google Gemini API Key for multimodal extraction on scans and handwritten documents.
# If omitted, system falls back gracefully to local fast-path PyMuPDF text & heuristic rule engines.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Worker Concurrency
WORKER_MAX_CONCURRENT_JOBS=5
